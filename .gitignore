# 墨墨 Token 的 DPAPI 加密文件（仅本机当前用户可解密，不入库）
.maimemo-token.enc

# Admin 本地临时文件（后台页面 src/app/admin 已纳入版本控制，用于备份）
# 注意：后台页面不会进入线上产物——build:pages 构建时由
# scripts/prepare-static-export.js 临时移出 src/app/admin，构建后自动恢复
admin-*
admin_*
*.tsbuildinfo
.migration-tmp/

# Trae AI 配置、规则与本地文档（个人环境相关，不纳入版本控制）
.trae/

# 本地环境与构建残留
.venv/
.build-backup/
.backup/

# 构建期生成的响应式图片变体（清单 src/data/blogImageManifest.json 保留）
public/_responsive/

# 构建期预渲染的开发日志正文片段（按需加载）
public/_changelog-content/

# Next.js 自动生成的类型引用：内容会在 dev/build 之间切换，避免工作区长期变脏
next-env.d.ts

# 临时调试/请求快照文件
.tmp-*
